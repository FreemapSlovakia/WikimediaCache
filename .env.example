DB_HOST=localhost
DB_PORT=5432
DB_USER=freemap
DB_PASSWORD=freemap
DB_NAME=freemap_wikimediacache
PORT=4000
USER_AGENT="FreemapCacheBot/1.0 (https://freemap.sk; freemap@freemap.sk)"
DUMP_URL="https://dumps.wikimedia.org/commonswiki/latest/commonswiki-latest-geo_tags.sql.gz"
BATCH_SIZE=5000
DUMP_PATH="/tmp/geo_tags.sql.gz"
CHECKPOINT_PATH="/tmp/geo_tags_import.checkpoint"
# Obe cesty su relativne k adresaru appky (nie k cwd).
# LOG_FILE  = chyby a prevadzkova stopa
# STAT_LOG_FILE = milniky a suhrny (okruhy prehrievania, denny suhrn, startup)
LOG_FILE="logs/wikimedia_errors.log"
STAT_LOG_FILE="logs/stat.log"
# Ako casto sa do stat.log zapisuje suhrn prehrievania cache (default 1h)
STAT_SUMMARY_INTERVAL_MS="3600000"
DOWNLOAD_CONCURRENCY=2
BBOX_SVK="16.83,47.73,22.57,49.61"
BBOX_SVK_CZ="12.09,47.73,22.57,51.05"
BBOX_V4="12.0,45.7,24.2,55.0"
BBOX_EU="-25,34,45,71"
WIKIMEDIA_ACCESS_TOKEN=""
WARM_CACHE_ENABLED=true
WARM_CACHE_INTERVAL_MS=1000
